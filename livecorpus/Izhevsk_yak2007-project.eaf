    <TIER ANNOTATOR="Yaroslava" LINGUISTIC_TYPE_REF="gesture_organs"
        PARENT_REF="gestType@yak2007f" PARTICIPANT="@yak2007f" TIER_ID="gestLegs@yak2007f"/>
    <TIER ANNOTATOR="Yaroslava" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@yak2007f" PARTICIPANT="@yak2007f" TIER_ID="gestComments@yak2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a479">
                <ANNOTATION_VALUE>Я посчитала это смущением,так какя посмеялась, а человек смотрел на меня</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a488">
                <ANNOTATION_VALUE>Адапторы смущения и внимания идут одновременно с адаптором волнения, поэтому временные границы условны</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a498">
                <ANNOTATION_VALUE>То есть я во время смеха еще теребила пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a519">
                <ANNOTATION_VALUE>Я думаю, что это беспокойство, потому что мне задали вопрос, на который я пока не придумала ответ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a537">
                <ANNOTATION_VALUE>Под конец жеста двигаю рукой, не знаю почему</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a550">
                <ANNOTATION_VALUE>Такое положение кистей отчасти напоминает неразрывную цепочку,поэтому я выбрала изобразительный жест</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a576" ANNOTATION_REF="a559">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a572" ANNOTATION_REF="a561">
                <ANNOTATION_VALUE>Я выбрала именно указательный жест,а не изобразительный, потому что я как бы указываю на более раннее событие.Также я назвала не просто "прошлое", потому что в паре "раннее-позднее" это не совсем про прошлое и будущее.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a575" ANNOTATION_REF="a564">
                <ANNOTATION_VALUE>В этом жесте так же, но более позднее событие</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a592">
                <ANNOTATION_VALUE>Качаю головой и одним плечом пожимаю</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a631" ANNOTATION_REF="a626">
                <ANNOTATION_VALUE>Здесь я подразумевала, что ребёнок сидит на этом стуле и может дотянуться до стола, но пока мозг не придумал предложение, которое могло описать это</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a632">
                <ANNOTATION_VALUE>Это прагматический жест, я им как бы показываю собеседнику, что подбираю нужное выражение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>Я использовала этот жест, чтобы показать собеседнику важное слово в предложении</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a663" ANNOTATION_REF="a652">
                <ANNOTATION_VALUE>Тут так же: "хочу себе", а не кому-нибудь другому</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a667" ANNOTATION_REF="a664">
                <ANNOTATION_VALUE>Два жеста идут практически одновременно, поэтому отметила так</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a681" ANNOTATION_REF="a672">
                <ANNOTATION_VALUE>Опять же указываю собеседнику на описание игрушки</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a689" ANNOTATION_REF="a686">
                <ANNOTATION_VALUE>Есть лёгкий кивок назад, я как будто вспоминаю слово "верблюда"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1352" ANNOTATION_REF="a1350">
                <ANNOTATION_VALUE>не знаю, почему делаю с закрытой ладонью, но я показываю, как глажу мягкого верблюда</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1363" ANNOTATION_REF="a1356">
                <ANNOTATION_VALUE>заканчиваю рассказ о верблюде</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1372" ANNOTATION_REF="a1367">
                <ANNOTATION_VALUE>продолжение жеста после мотания головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1381" ANNOTATION_REF="a1377">
                <ANNOTATION_VALUE>показываю, что это воспоминание позже другого</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1393" ANNOTATION_REF="a1386">
                <ANNOTATION_VALUE>однвременно подытоживаю и поворачиваю голову в знак внимания</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1412" ANNOTATION_REF="a1406">
                <ANNOTATION_VALUE>реплика собеседника показалась забавной</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1433" ANNOTATION_REF="a1422">
                <ANNOTATION_VALUE>жесты идут одновременно</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1438" ANNOTATION_REF="a1434">
                <ANNOTATION_VALUE>разметила эти адапторы как два разных, потому что первый относился к одновременности с адаптором веселья, а второй как отдельно</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1463" ANNOTATION_REF="a1461">
                <ANNOTATION_VALUE>непонятно, почему на этом моменте встряхнула головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1451" ANNOTATION_REF="a1443">
                <ANNOTATION_VALUE>указала эти жесты как разные, так как в конце я пальцем снова показываю на время</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1460" ANNOTATION_REF="a1452">
                <ANNOTATION_VALUE>головой тоже есть слабый кивок в сторону</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1491" ANNOTATION_REF="a1485">
                <ANNOTATION_VALUE>два жеста (головой и руками) идут друг за другом, тот, что руками обозначает акцент на слове "уроков"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1500" ANNOTATION_REF="a1494">
                <ANNOTATION_VALUE>повернула голову,как знак,что услышала вопрос, но нужно подумать над ответом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1503" ANNOTATION_REF="a1497">
                <ANNOTATION_VALUE>повернула не до конца голову как способ узнать, ждёт ли собеседник ответа</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1543" ANNOTATION_REF="a1523">
                <ANNOTATION_VALUE>помимо ладоней ещё слегка выпрямляю локти</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1566" ANNOTATION_REF="a1549">
                <ANNOTATION_VALUE>головой как бы исправляю неправильную форму</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1563" ANNOTATION_REF="a1559">
                <ANNOTATION_VALUE>а ладонями утверждаю правильную</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1596" ANNOTATION_REF="a1581">
                <ANNOTATION_VALUE>разделила два адаптора,так как второй адаптор идет одновременно с прагматическим жестом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1591" ANNOTATION_REF="a1582">
                <ANNOTATION_VALUE>разделила эти два жеста, потому что как два кивка - два слова</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1632" ANNOTATION_REF="a1628">
                <ANNOTATION_VALUE>ещё пожимаю слегка плечами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1642" ANNOTATION_REF="a1636">
                <ANNOTATION_VALUE>поднимаю и опускаю плечи как знак неуверенности/приблизительности (но не незнания))</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1670" ANNOTATION_REF="a1664">
                <ANNOTATION_VALUE>продолжение того же жеста</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1724" ANNOTATION_REF="a1720">
                <ANNOTATION_VALUE>я этим жестом как будто бы собрала мысль воедино</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1749" ANNOTATION_REF="a1741">
                <ANNOTATION_VALUE>помимо головы немного двигаю плечами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1762" ANNOTATION_REF="a1753">
                <ANNOTATION_VALUE>помогаю себе говорить</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1836" ANNOTATION_REF="a1830">
                <ANNOTATION_VALUE>то есть как бы рассказываю какую-то новую информацию, факт</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1856" ANNOTATION_REF="a1851">
                <ANNOTATION_VALUE>это можно еще расценить как смена позы для того,чтобы обдумать ответ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1866" ANNOTATION_REF="a1857">
                <ANNOTATION_VALUE>чешу руку не потому что чесалась,а из-за волнения</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1947" ANNOTATION_REF="a1941">
                <ANNOTATION_VALUE>качаю головой из стороны в сторону</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2003" ANNOTATION_REF="a1993">
                <ANNOTATION_VALUE>дёрнулась как-то телом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
